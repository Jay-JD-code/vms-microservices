# ============================================
# VMS Environment Variables - Copy to /opt/vms/.env
# ============================================

# Docker Hub
DOCKER_USER=your-dockerhub-username

# Eureka (Instance 1 Private IP)
EUREKA_IP=10.0.1.10

# Neon PostgreSQL - Get these from neon.tech
DB_USER=neondb_owner
DB_PASS=npg_your-password

AUTH_DB_URL=jdbc:postgresql://your-neon-host:5432/authdb
VENDOR_DB_URL=jdbc:postgresql://your-neon-host:5432/vendorsdb
ORDERS_DB_URL=jdbc:postgresql://your-neon-host:5432/ordersdb
PAYMENTS_DB_URL=jdbc:postgresql://your-neon-host:5432/paymentsdb
DOCUMENT_DB_URL=jdbc:postgresql://your-neon-host:5432/documentdb

# Gmail SMTP
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# AWS S3
AWS_ACCESS_KEY=your-aws-key
AWS_SECRET_KEY=your-aws-secret
AWS_REGION=ap-southeast-1
